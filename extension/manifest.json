{
  "manifest_version": 3,
  "name": "Jobflow LinkedIn Bridge",
  "version": "0.1.0",
  "description": "Extract visible LinkedIn job details for user-reviewed analysis in Jobflow.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://www.linkedin.com/jobs/*", "http://localhost:3000/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Analyze this LinkedIn job", "default_popup": "popup/popup.html" },
  "content_scripts": [{ "matches": ["https://www.linkedin.com/jobs/*"], "js": ["content/linkedin-job.js"], "run_at": "document_idle" }],
  "icons": {}
}
